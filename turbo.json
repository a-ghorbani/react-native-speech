{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build:android": {
      "env": ["ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "src/**",
        "react-native.config.js",
        "android/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**",
        "!android/app/.cxx/**",
        "../package.json",
        "../src/**",
        "../cpp/**",
        "../android/**",
        "!../android/build/**",
        "!../android/.cxx/**",
        "../packages/react-native-speech-phonon/package.json",
        "../packages/react-native-speech-phonon/react-native.config.js",
        "../packages/react-native-speech-phonon/phonon.lock.json",
        "../packages/react-native-speech-phonon/src/**",
        "../packages/react-native-speech-phonon/cpp/**",
        "../packages/react-native-speech-phonon/android/**",
        "!../packages/react-native-speech-phonon/android/build/**",
        "!../packages/react-native-speech-phonon/android/.cxx/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "src/**",
        "react-native.config.js",
        "ios/**",
        "!ios/build/**",
        "!ios/Pods/**",
        "../package.json",
        "../*.podspec",
        "../src/**",
        "../cpp/**",
        "../ios/**",
        "../packages/react-native-speech-phonon/package.json",
        "../packages/react-native-speech-phonon/react-native.config.js",
        "../packages/react-native-speech-phonon/phonon.lock.json",
        "../packages/react-native-speech-phonon/RNSpeechPhonon.podspec",
        "../packages/react-native-speech-phonon/src/**",
        "../packages/react-native-speech-phonon/cpp/**",
        "../packages/react-native-speech-phonon/ios/**",
        "!../packages/react-native-speech-phonon/ios/PhononCore.xcframework/**"
      ],
      "outputs": []
    }
  }
}
